{
  "name": "evidentia-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:mock": "vite --mode mock --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json --default-non-nullable false -o src/lib/api-types.ts",
    "build:3d-models": "node scripts/crime-scene-models/build.mjs",
    "postinstall": "npm --prefix ../packages/scene-engine install --no-audit --no-fund && npm --prefix ../packages/scene-engine run build && npm --prefix ../packages/scene-planner install --no-audit --no-fund && npm --prefix ../packages/scene-planner run build",
    "test:anatomy": "node scripts/anatomy/test.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@evidentia/scene-engine": "file:../packages/scene-engine",
    "@evidentia/scene-planner": "file:../packages/scene-planner",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.104.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.12.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "vite": "^6.2.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
