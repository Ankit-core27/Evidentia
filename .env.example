# Copy to .env at the repo root. Both apps read it; never commit .env.

# Backend. Relative paths resolve against backend/.
DATABASE_URL=sqlite:///../storage/evidentia.db
STORAGE_DIR=../storage

# Gemini (https://aistudio.google.com/apikey). Without a key the backend still
# runs: uploads are stored and hashed, but AI extraction and answers are off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Frontend. Needed from M6 (geographic view).
VITE_CESIUM_ION_TOKEN=
