# Copy to .env at the repo root. Both apps read it; never commit .env.

# Backend. Relative paths resolve against backend/.
DATABASE_URL=sqlite:///../storage/evidentia.db
STORAGE_DIR=../storage

# Gemini (https://aistudio.google.com/apikey). Without a key the backend still
# runs: uploads are stored and hashed, but AI extraction and answers are off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Frontend: the case's "Area & buildings" view. Either key shows the area as
# Google Photorealistic 3D Tiles (the textured 3D city of Google Earth). Without
# both, it shows flat satellite imagery.
# Google Maps Platform key with the Map Tiles API enabled
# (https://developers.google.com/maps/documentation/tile/3d-tiles):
VITE_GOOGLE_MAPS_API_KEY=
# Or a free Cesium ion token (https://ion.cesium.com/tokens); ion serves the same
# Google tiles, plus world terrain and OSM buildings as a fallback.
VITE_CESIUM_ION_TOKEN=
